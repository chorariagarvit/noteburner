{
    "manifest_version": 3,
    "name": "NoteBurner",
    "version": "1.14.0",
    "description": "Send self-destructing encrypted messages directly from any webpage",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "contextMenus",
        "activeTab",
        "scripting",
        "storage",
        "notifications"
    ],
    "host_permissions": [
        "https://api.noteburner.work/*",
        "https://noteburner.work/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "NoteBurner - Quick Encrypt"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "extension@noteburner.work",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}