{
  "name": "noteburner-backend",
  "version": "1.14.0",
  "description": "NoteBurner backend API - Cloudflare Workers (v1.14.0)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local --var FRONTEND_URL:http://localhost:5173 --var RATE_LIMIT_REQUESTS:100 --var APP_TOKEN_SECRET:dev-app-token-secret --var STRIPE_WEBHOOK_SECRET:dev-stripe-webhook-secret",
    "dev:setup": "wrangler d1 migrations apply noteburner-db --local < /dev/null || true",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "tail": "wrangler tail",
    "d1:create": "wrangler d1 create noteburner-db",
    "d1:migrations:apply": "wrangler d1 migrations apply noteburner-db",
    "d1:migrations:create": "wrangler d1 migrations create noteburner-db"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "encryption"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.19",
    "nanoid": "^6.0.2"
  }
}
